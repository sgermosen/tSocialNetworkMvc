@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    string ActiveIf(string controller) => currentController == controller ? "active" : "";
    var userName = User.Identity.IsAuthenticated ? User.Identity.Name : "";
    var initials = string.IsNullOrEmpty(userName) ? "?" : userName.Substring(0, 1).ToUpper();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0d9488" />
    <title>@ViewData["Title"] · Tetas</title>

    <script>
        (function () {
            var t = localStorage.getItem("tetas-theme") || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
            document.documentElement.setAttribute("data-theme", t);
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    </noscript>

    <link href="~/lib/fontawesome/css/all.css" rel="stylesheet" />
    <link href="~/lib/fontawesome/css/fontawesome.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <div class="scrim" id="scrim"></div>
        <aside class="sidebar" id="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark"><i class="fas fa-graduation-cap"></i></span>
                Tetas
            </a>
            <nav class="side-nav">
                @if (User.Identity.IsAuthenticated)
                {
                    <a class="nav-link @ActiveIf("Home")" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-house"></i> Home
                    </a>
                    <a class="nav-link @ActiveIf("Posts")" asp-controller="Posts" asp-action="Index">
                        <i class="fas fa-pen-nib"></i> My Posts
                    </a>
                    <a class="nav-link @ActiveIf("Groups")" asp-controller="Groups" asp-action="Index">
                        <i class="fas fa-users"></i> Groups
                    </a>
                }
                else
                {
                    <a class="nav-link @(currentAction == "Login" ? "active" : "")" asp-controller="Account" asp-action="Login">
                        <i class="fas fa-right-to-bracket"></i> Login
                    </a>
                    <a class="nav-link @(currentAction == "Register" ? "active" : "")" asp-controller="Account" asp-action="Register">
                        <i class="fas fa-user-plus"></i> Join Us
                    </a>
                }
            </nav>
            <div class="side-foot">
                Tracking Education For Teachers and Students
            </div>
        </aside>

        <div class="main-area">
            <header class="topbar">
                <button class="icon-btn mobile-only" id="menuToggle" type="button" aria-label="Menu">
                    <i class="fas fa-bars"></i>
                </button>
                <h1 class="page-title">@ViewData["Title"]</h1>
                <span class="spacer"></span>
                <button class="icon-btn" id="themeToggle" type="button" aria-label="Toggle theme">
                    <i class="fas fa-moon"></i>
                </button>
                @if (User.Identity.IsAuthenticated)
                {
                    <div class="dropdown">
                        <a class="user-chip dropdown-toggle" href="#" role="button" id="userMenu" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <span class="avatar">@initials</span>
                            <span>@userName</span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="userMenu">
                            <a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="fas fa-user"></i> Profile</a>
                            <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="fas fa-key"></i> Change Password</a>
                            <a class="dropdown-item" asp-controller="Account" asp-action="Logout"><i class="fas fa-right-from-bracket"></i> Log out</a>
                        </div>
                    </div>
                }
                else
                {
                    <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Connect</a>
                }
            </header>

            <main class="content" role="main">
                @Html.AntiForgeryToken()
                @RenderBody()
            </main>

            <footer class="footer">
                &copy; @DateTime.Now.Year Tetas · sGermosen · <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
    <script src="~/lib/fontawesome/js/all.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
