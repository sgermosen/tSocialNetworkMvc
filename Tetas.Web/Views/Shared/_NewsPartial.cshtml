@model IEnumerable<Tetas.Domain.Entities.Post>
@{
    string Initial(string name) => string.IsNullOrEmpty(name) ? "?" : name.Substring(0, 1).ToUpper();
    var currentUserId = ViewBag.CurrentUserId as string;
}

<div class="row-gap" style="margin-bottom: 1.2rem;">
    <a asp-action="Create" asp-controller="Posts" class="btn btn-primary">
        <i class="fas fa-plus"></i> Create new post
    </a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="far fa-newspaper"></i>
        <p>No posts yet. Be the first to share something.</p>
    </div>
}
else
{
    foreach (var item in Model)
    {
        <article class="post">
            <div class="post-head">
                <span class="avatar">@Initial(item.Owner.FullName)</span>
                <div>
                    <a class="post-author" asp-route-id="@item.Owner.Email" asp-controller="Account" asp-action="Profile">
                        @item.Owner.FullName
                    </a>
                    <div class="post-meta">posted @Html.DisplayFor(m => item.Date)</div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(item.Name))
            {
                <h2 class="post-title">
                    <a asp-route-id="@item.Id" asp-controller="Posts" asp-action="Details">@item.Name</a>
                </h2>
            }
            <div class="post-body"><pre>@Html.Raw(item.Body)</pre></div>

            <div class="post-actions">
                @{
                    var reactionCount = item.Reactions?.Count ?? 0;
                    var iReacted = item.Reactions != null && !string.IsNullOrEmpty(currentUserId)
                        && item.Reactions.Any(r => r.OwnerId == currentUserId);
                }
                <button type="button" class="post-action @(iReacted ? "reacted" : "")" onclick="tetasReact(this, @item.Id)">
                    <i class="fas fa-heart"></i> <span class="react-count">@reactionCount</span>
                </button>
                <a class="post-action" asp-action="Comment" asp-controller="Posts" asp-route-id="@item.Id">
                    <i class="far fa-comment"></i> Comment
                </a>
                <a class="post-action" asp-action="Details" asp-controller="Posts" asp-route-id="@item.Id">
                    <i class="far fa-eye"></i> Details
                </a>
                @if (item.Owner.Email == User.Identity.Name)
                {
                    <a class="post-action" asp-action="Edit" asp-controller="Posts" asp-route-id="@item.Id">
                        <i class="far fa-edit"></i> Edit
                    </a>
                    <a class="post-action danger" asp-action="Delete" asp-controller="Posts" asp-route-id="@item.Id">
                        <i class="far fa-trash-alt"></i> Delete
                    </a>
                }
            </div>

            @if (item.PostComments != null && item.PostComments.Any())
            {
                <div style="margin-top: 0.6rem;">
                    @foreach (var comment in item.PostComments)
                    {
                        <div class="comment">
                            <span class="avatar">@Initial(comment.Owner.FullName)</span>
                            <div class="comment-bubble">
                                <div class="post-meta">
                                    <a class="post-author" asp-route-id="@comment.Owner.Email" asp-controller="Account" asp-action="Profile">@comment.Owner.FullName</a>
                                    · @Html.DisplayFor(m => comment.Date)
                                </div>
                                @if (!string.IsNullOrEmpty(comment.Name))
                                {
                                    <strong>@comment.Name</strong>
                                }
                                <div>@Html.Raw(comment.Body)</div>
                                <div class="row-gap" style="margin-top: 0.4rem;">
                                    @if (comment.Owner.Email == User.Identity.Name)
                                    {
                                        <a class="post-action" asp-action="EditComment" asp-controller="Posts" asp-route-id="@comment.Id">
                                            <i class="far fa-comment-dots"></i> Edit
                                        </a>
                                    }
                                    @if (comment.Owner.Email == User.Identity.Name || item.Owner.Email == User.Identity.Name)
                                    {
                                        <a class="post-action danger" asp-action="DeleteComment" asp-controller="Posts" asp-route-id="@comment.Id">
                                            <i class="fas fa-comment-slash"></i> Delete
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </article>
    }
}
