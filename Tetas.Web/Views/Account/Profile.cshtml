@model Tetas.Common.ViewModels.ProfileModel

@{
    ViewData["Title"] = "Profile";
    var initial = string.IsNullOrEmpty(Model.FullName) ? "?" : Model.FullName.Substring(0, 1).ToUpper();
}

<div class="form-wide">
    <div class="card">
        <div class="card-body">
            <div class="row-gap" style="gap:1.2rem; align-items:flex-start;">
                <span class="avatar avatar-lg">@initial</span>
                <div style="flex:1;">
                    <h1 style="margin:0;">@Model.FullName</h1>
                    <p class="text-muted" style="margin:0.2rem 0 0;">
                        <i class="fas fa-envelope"></i> @Model.Email
                        @if (!string.IsNullOrEmpty(Model.Phone))
                        {
                            <span>&nbsp; · &nbsp;<i class="fas fa-phone"></i> @Model.Phone</span>
                        }
                    </p>
                    @if (Model.IsMe)
                    {
                        <div class="row-gap" style="margin-top:1rem;">
                            <a class="btn btn-secondary" asp-action="EditProfile"><i class="far fa-edit"></i> Edit profile</a>
                            <a class="btn btn-secondary" asp-action="ChangePassword"><i class="fas fa-key"></i> Change password</a>
                        </div>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Bio))
            {
                <hr />
                <h3 style="font-size:1.05rem;">About</h3>
                <p style="margin:0;">@Html.Raw(Model.Bio)</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
