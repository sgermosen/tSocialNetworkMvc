@using Tetas.Domain.Entities
@using Tetas.Common.ViewModels
@{
    ViewData["Title"] = User.Identity.IsAuthenticated ? "Home" : "Welcome";
    var postList = new List<Post>();
}

@if (!User.Identity.IsAuthenticated)
{
    @if (!string.IsNullOrEmpty(ViewBag.Message as string))
    {
        <div class="alert alert-success">@ViewBag.Message</div>
    }

    <section class="hero">
        <span class="eyebrow">Open source · For education</span>
        <h1>The social network built for teachers and students.</h1>
        <p>
            Tetas is an open source social platform for building all kinds of academic
            communities — a campus-wide network for your university, a collaboration
            space for your organization, or a place to keep learning and professional
            circles connected without mixing them with your personal life.
        </p>
        <div class="hero-cta">
            <a class="btn btn-primary" asp-controller="Account" asp-action="Register">
                <i class="fas fa-user-plus"></i> Create your account
            </a>
            <a class="btn btn-secondary" asp-controller="Account" asp-action="Login">
                Log in
            </a>
        </div>
    </section>

    <div class="feature-grid">
        <div class="feature">
            <i class="fas fa-pen-nib"></i>
            <h3>Share posts</h3>
            <p>Publish, edit and discuss ideas with your academic community.</p>
        </div>
        <div class="feature">
            <i class="fas fa-users"></i>
            <h3>Build groups</h3>
            <p>Create public or private groups for classes, clubs and projects.</p>
        </div>
        <div class="feature">
            <i class="fas fa-comments"></i>
            <h3>Stay connected</h3>
            <p>Comment, moderate and keep the conversation going with peers.</p>
        </div>
    </div>
}
else
{
    <div class="page-head">
        <h1>Latest posts</h1>
        <p>The most recent activity from your network.</p>
    </div>

    <div id="newsContent">
        <partial name="_NewsPartial" model="postList" />
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
        <script>
            $(document).ready(function () {
                $.ajax({
                    type: "GET",
                    url: '@Url.Action("PostFilter", "Home")',
                    success: function (data) {
                        $('#newsContent').html(data);
                    },
                    error: function () {
                        console.log("problems retrieving post data");
                    }
                });
            });
        </script>
    }
}
